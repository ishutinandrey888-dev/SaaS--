# Compose-level .env consumed by all backend services.
# Mirror all keys from backend/.env.example, plus deploy-only vars below.
# Copy to deploy/.env on the VPS and fill real values.

# === Backend app (see backend/.env.example for meaning) ==============
ENV=prod
# See docs/db-roles.sql: two roles with distinct privileges.
# Runtime URLs use the Supabase transaction pooler (port 6543);
# DATABASE_URL_SYNC uses direct/session mode (5432) for Alembic.
DATABASE_URL_ADMIN=postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:6543/postgres?ssl=require
DATABASE_URL_USER=postgresql+asyncpg://app_user:APP_USER_PASSWORD@db.xxx.supabase.co:6543/postgres?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_MONTHLY_BUDGET_MINOR=2000000
AI_BUDGET_ALERT_THRESHOLD_PCT=80
FERNET_KEY=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REDIS_URL=redis://redis:6379/0
ADMIN_EMAILS=admin@dozim.ai
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
CODE_AUDIT_SCHEDULE_DAYS=3
PAYMENT_RETURN_URL=https://your-domain.tld/billing/success
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=false
ROBOKASSA_WEBHOOK_IPS=
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=
YANDEX_DIRECT_OAUTH_REDIRECT_URL=https://your-domain.tld/api/yandex/oauth/callback
YANDEX_DIRECT_API_BASE=https://api.direct.yandex.com/json/v5
PAGESPEED_API_KEY=
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/var/app/uploads
CORS_ORIGINS=https://your-domain.tld
PUBLIC_DOMAIN=your-domain.tld

# === Deploy-only =====================================================
# (none right now — reserved for docker-compose-specific toggles)
