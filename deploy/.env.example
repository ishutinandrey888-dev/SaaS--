# Compose-level .env consumed by all backend services.
# Mirror all keys from backend/.env.example, plus deploy-only vars below.
# Copy to deploy/.env on the VPS and fill real values.

# === Backend app (see backend/.env.example for meaning) ==============
ENV=prod
# See docs/db-roles.sql: two roles with distinct privileges.
DATABASE_URL_ADMIN=postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?ssl=require
DATABASE_URL_USER=postgresql+asyncpg://app_user:APP_USER_PASSWORD@db.xxx.supabase.co:5432/postgres?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
FERNET_KEY=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REDIS_URL=redis://redis:6379/0
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAGESPEED_API_KEY=
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/var/app/uploads
CORS_ORIGINS=https://your-domain.tld
PUBLIC_DOMAIN=your-domain.tld

# === Deploy-only =====================================================
# (none right now — reserved for docker-compose-specific toggles)
