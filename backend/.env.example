# --- Database (Supabase-managed Postgres, hybrid deploy) -------------
# Two roles are needed (see docs/db-roles.sql and docs/vps-setup.md §1a):
#   * postgres  — BYPASSRLS owner, used for auth/celery/webhooks/audit.
#   * app_user  — NOBYPASSRLS, used by user-scoped routes so RLS works.
#
# Connection endpoints:
#   * Port 6543 — Supabase "Transaction mode" pooler.  Use for the two
#     runtime URLs below (ADMIN + USER).  Supports set_config(..., true)
#     inside a transaction, which is all we need, and scales to hundreds
#     of logical clients per instance.
#   * Port 5432 — direct / session mode.  Use for DATABASE_URL_SYNC
#     (Alembic needs session features) and nothing else at runtime.
DATABASE_URL_ADMIN=postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:6543/postgres?ssl=require
DATABASE_URL_USER=postgresql+asyncpg://app_user:APP_USER_PASSWORD@db.xxx.supabase.co:6543/postgres?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require

# Per-engine pool sizing.  See app/core/database.py — defaults are fine
# for the transaction pooler; bump only if you see pool-timeout warnings.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Supabase project ------------------------------------------------
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
FERNET_KEY=generate-with-Fernet.generate_key
JWT_SECRET=change-me-min-32-chars-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REDIS_URL=redis://redis:6379/0

# --- Robokassa (payments) -------------------------------------------
# Empty values activate stub mode: /billing/success auto-completes
# without calling the real provider.  Useful for local dev + CI.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=true
ROBOKASSA_WEBHOOK_IPS=

# --- Yandex Direct OAuth --------------------------------------------
# Empty client_id activates stub mode: the OAuth callback fabricates
# a fake ad_account so the agent flow runs without registering an
# OAuth app at id.yandex.ru.
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=
YANDEX_DIRECT_OAUTH_REDIRECT_URL=http://localhost:8000/yandex/oauth/callback
YANDEX_DIRECT_API_BASE=https://api.direct.yandex.com/json/v5

PAGESPEED_API_KEY=
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/var/app/uploads
CORS_ORIGINS=https://your-domain.tld,http://localhost:3000
ENV=prod
PUBLIC_DOMAIN=your-domain.tld
