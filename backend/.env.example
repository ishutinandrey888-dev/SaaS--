# --- Database (Supabase-managed Postgres, hybrid deploy) -------------
# Two roles are needed (see docs/db-roles.sql and docs/vps-setup.md §1a):
#   * postgres  — BYPASSRLS owner, used for auth/celery/webhooks/audit.
#   * app_user  — NOBYPASSRLS, used by user-scoped routes so RLS works.
#
# Use Supabase "Connection pooling" → "Session mode" URLs and append
# sslmode=require (psycopg2) / ssl=require (asyncpg).
DATABASE_URL_ADMIN=postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?ssl=require
DATABASE_URL_USER=postgresql+asyncpg://app_user:APP_USER_PASSWORD@db.xxx.supabase.co:5432/postgres?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require

# --- Supabase project ------------------------------------------------
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
FERNET_KEY=generate-with-Fernet.generate_key
JWT_SECRET=change-me-min-32-chars-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REDIS_URL=redis://redis:6379/0
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAGESPEED_API_KEY=
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/var/app/uploads
CORS_ORIGINS=https://your-domain.tld,http://localhost:3000
ENV=prod
PUBLIC_DOMAIN=your-domain.tld
