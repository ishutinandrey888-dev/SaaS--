# --- Database (Supabase-managed Postgres, hybrid deploy) -------------
# Use the "Connection pooling" → "Session mode" URL from Supabase
# and append sslmode=require.  For asyncpg, pass ssl=require.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres?sslmode=require

# --- Supabase project ------------------------------------------------
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
FERNET_KEY=generate-with-Fernet.generate_key
JWT_SECRET=change-me-min-32-chars-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REDIS_URL=redis://redis:6379/0
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAGESPEED_API_KEY=
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/var/app/uploads
CORS_ORIGINS=https://your-domain.tld,http://localhost:3000
ENV=prod
PUBLIC_DOMAIN=your-domain.tld
