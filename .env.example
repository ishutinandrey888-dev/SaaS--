# Optional: copy to `.env` and fill in.  All values have sensible
# defaults for the local demo — you can run `docker compose up`
# without this file and register/audit flow will work end-to-end
# with the payment stub.  AI rewriting degrades to "no improvement"
# without an OpenAI key.

# Real GPT calls.  Leave blank to skip — the app still parses Excel,
# shows the audit, and lets you export; the "improved" column just
# stays empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Comma-separated list of emails that can see /admin (the funnel).
# Set this to the email you register with to view metrics.
ADMIN_EMAILS=

# Optional: stable encryption key.  Auto-generated on first start if
# blank; set explicitly if you want user sessions to survive restarts.
FERNET_KEY=
